# ─────────────────────────────────────────────────────────────
# Client-side variables (Vite — exposed to the browser, must be VITE_*)
# Backend is the shared Mindmaker AI Supabase project. For deploys these are set
# in Vercel (Production / Preview / Development), not committed here.
# ─────────────────────────────────────────────────────────────
VITE_SUPABASE_URL="https://your-project.supabase.co"        # Supabase project URL
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"      # Supabase anon/publishable key
VITE_SUPABASE_PROJECT_ID="your-project-id"                 # Supabase project ref id (used by Supabase CLI)

# ─────────────────────────────────────────────────────────────
# Server-side secrets (Supabase Edge Functions — never expose to client)
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY="re_..."                                    # Resend API key for transactional email
